# ─── Plush Comfort UK — environment variables ───
# Copy to .env and fill in. See SETUP_DATABASE_AND_SERVICES.md for step-by-step help.

NODE_ENV=production
PORT=3000
# Public address of the store (used for canonical URLs, sitemap, Open Graph)
SITE_URL=https://plushcomfort.uk

# ─── Database ───
# Leave empty to store data as JSON files in ./data (single server with a permanent disk).
# MySQL / MariaDB example: mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL=
# true for managed databases that require SSL (Aiven, PlanetScale-compatible, Cloud SQL…)
DATABASE_SSL=false
# DB_REFRESH_MS=3000
# DATA_DIR=./data
# UPLOADS_DIR=./public/uploads

# ─── Email (owner login codes & password reset) ───
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Plush Comfort UK <no-reply@plushcomfort.uk>"

# ─── Google reCAPTCHA v2 checkbox (staff login) ───
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ─── WhatsApp Cloud API (owner login codes by WhatsApp) ───
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en_GB

# Server-side rendering is on by default (better SEO & speed). Set true only to debug.
# DISABLE_SSR=false

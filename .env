# ─── Plush Comfort UK — environment variables ───
# Copy to .env and fill in. See SETUP_DATABASE_AND_SERVICES.md for step-by-step help.

NODE_ENV=production
PORT=3000
# Public address of the store (used for canonical URLs, sitemap, Open Graph)
SITE_URL=https://plushcomfort.uk

# ─── Database ───
# Leave empty to store data as JSON files in ./data (single server with a permanent disk).
# MySQL / MariaDB example: mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL="postgresql://neondb_owner:npg_aOL0F9hfToMe@ep-steep-flower-b7u79ewo-pooler.c-13.us-east-1.aws.neon.tech/db-plushcomfort?sslmode=require&channel_binding=require"
